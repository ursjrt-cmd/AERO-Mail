# Supabase project settings (the service role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Public website settings
NEXT_PUBLIC_APP_URL=https://mail.aero.ist
NEXT_PUBLIC_MAILBOX_DEFAULT_DOMAIN=aero.ist

# Keep these domain lists empty until a site administrator has verified ownership and enabled the domain in Resend.
# These three comma-separated lists may contain multiple domains.
MAILBOX_ALLOWED_DOMAINS=
RESEND_SENDING_DOMAINS=
RESEND_RECEIVING_DOMAINS=

# Resend API (server only)
RESEND_API_KEY=re_REPLACE_WITH_API_KEY
RESEND_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SIGNING_SECRET
RESEND_FROM_NAME=AERO Mail

# Optional AI draft improvement (server only)
OPENAI_API_KEY=
OPENAI_MODEL=
