# Supabase project values (server-side only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET

# Copy from Supabase Dashboard > Connect > Session pooler (port 5432)
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Resend
RESEND_API_KEY=re_your_api_key
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
RESEND_FROM_NAME=AERO Mail

# Set these to aero.ist ONLY after Resend has verified sending and receiving DNS
MAILBOX_DEFAULT_DOMAIN=aero.ist
MAILBOX_ALLOWED_DOMAINS=
RESEND_SENDING_DOMAINS=
RESEND_RECEIVING_DOMAINS=

# Your deployed URL (Render onrender.com URL first, then your custom domain)
APP_URL=https://your-render-service.onrender.com

# Optional AI email-writing feature
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
